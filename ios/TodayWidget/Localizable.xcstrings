    "widget.today.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s tasks, tick them off here"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc hôm nay, tick xong ngay tại đây"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de hoy; márcalas aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches du jour, à cocher ici"
          }
        },
        "de": {
