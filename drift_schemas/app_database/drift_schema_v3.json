  "fixed_sql": [
    {
      "name": "task_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_value\" INTEGER NOT NULL, \"sort_order\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NULL REFERENCES task_lists (id), \"parent_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"due_date\" TEXT NULL, \"due_time\" INTEGER NULL, \"priority\" INTEGER NOT NULL DEFAULT 0, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"done_at\" INTEGER NULL, \"rrule\" TEXT NULL, \"reminders\" TEXT NOT NULL DEFAULT '', \"alarm\" INTEGER NOT NULL DEFAULT 0 CHECK (\"alarm\" IN (0, 1)), \"estimate_minutes\" INTEGER NULL, \"snoozed_until\" INTEGER NULL, \"sort_order\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "activity_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_days\" (\"day\" TEXT NOT NULL, \"completed_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"day\"));"
        }
      ]
    },
